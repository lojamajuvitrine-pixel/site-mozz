# URL publica do site (usada nos back_urls do Mercado Pago, sitemap, SEO e no webhook)
NEXT_PUBLIC_SITE_URL=https://lojamozz.com.br

# Bling API v3 - app OAuth2 (developer.bling.com.br)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=

# Mercado Pago - Checkout Pro (mercadopago.com.br/developers/panel/app)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Chave secreta do webhook (painel Mercado Pago > sua aplicacao > Webhooks > "Assinatura secreta")
MERCADOPAGO_WEBHOOK_SECRET=

# Melhor Envio - calculo de frete por CEP (melhorenvio.com.br)
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CEP_ORIGEM=
MELHOR_ENVIO_SANDBOX=true

# Melhor Envio - compra/geracao automatica de etiqueta + rastreio (app OAuth em
# app.melhorenvio.com.br/integracoes/area-dev). CLIENT_ID/SECRET vem da tela de cadastro do
# aplicativo; o token de acesso em si fica guardado no Supabase (tabela
# melhor_envio_oauth_token), preenchido automaticamente pelo fluxo em
# app/api/melhorenvio/callback - nunca colado aqui a mao.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# Segredo usado pra validar a assinatura dos webhooks do Melhor Envio (X-ME-Signature) -
# configurado na hora de cadastrar o webhook no painel deles.
MELHOR_ENVIO_WEBHOOK_SECRET=
# CNPJ, CPF do responsavel, e-mail e endereco de quem ENVIA (a MOZZ) - obrigatorios em toda
# etiqueta gerada. O Melhor Envio exige um CPF no campo "document" mesmo pra remetente pessoa
# juridica (descoberto testando em producao em 31/08/2026) - por isso as DUAS variaveis de
# documento abaixo, nao so' o CNPJ.
MELHOR_ENVIO_REMETENTE_DOCUMENTO=
MELHOR_ENVIO_REMETENTE_CPF_RESPONSAVEL=
MELHOR_ENVIO_REMETENTE_EMAIL=

# Resend - envio de e-mail transacional (resend.com). Mesma conta ja usada pelo aviso de
# "voltou ao estoque" (scripts/avisoEstoque.ts, roda via GitHub Actions) - essa aqui e' a
# mesma chave, so' que configurada AQUI TAMBEM (Vercel) pro e-mail de confirmacao de pedido,
# que roda no site (ver lib/emailPedido.ts).
RESEND_API_KEY=

# Meta Pixel + Google Analytics - rastreamento de anuncios/trafego (opcional)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=

# Supabase - login sem senha (magic link) e area "Minha conta" (supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Supabase > Project Settings > API) - usada so' pelos callbacks OAuth
# (Bling, Melhor Envio) pra gravar o token direto, sem depender de nenhuma politica publica.
# Fica so' na Vercel, nunca no navegador (nome sem NEXT_PUBLIC_ de proposito).
SUPABASE_SERVICE_ROLE_KEY=
